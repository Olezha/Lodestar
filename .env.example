# ==============================================================================
# Lodestar Environment Variables Template (.env.example)
# Copy to '.env' and adjust values: cp .env.example .env
# ==============================================================================

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/lodestar_db
DB_USERNAME=postgres
DB_PASSWORD=postgres_password

# --- Message Broker (RabbitMQ) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- In-Memory Cache (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Event Streaming (Apache Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Notification Gateways ---
# Discord Webhook (set dry-run=false and provide webhook URL for live testing)
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME="Lodestar Alerts"
DISCORD_DRY_RUN=true

# ntfy.sh (free push notifications, dry-run=false to receive pushes on mobile app)
NTFY_SERVER_URL=https://ntfy.sh
NTFY_DEFAULT_TOPIC=lodestar-alerts
NTFY_DRY_RUN=true
