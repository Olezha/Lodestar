# ==============================================================================
# Lodestar Environment Variables Template (.env.example)
# Copy to '.env' and adjust values: cp .env.example .env
# ==============================================================================

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/lodestar_db
DB_USERNAME=postgres
DB_PASSWORD=postgres_password

# --- Message Broker (RabbitMQ) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- In-Memory Cache (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Event Streaming (Apache Kafka) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Notification Gateways ---
# Discord Webhook (set dry-run=false and provide webhook URL for live testing)
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME="Lodestar Alerts"
DISCORD_DRY_RUN=true

# ntfy.sh (free push notifications, dry-run=false to receive pushes on mobile app)
NTFY_SERVER_URL=https://ntfy.sh
NTFY_DEFAULT_TOPIC=lodestar-alerts
NTFY_DRY_RUN=true

# --- alerts.in.ua API Ingestion ---
# Set ALERT_SOURCE_TYPE to 'live' to ingest from alerts.in.ua or 'synthetic' for internal generator
ALERT_SOURCE_TYPE=synthetic
ALERTS_POLL_INTERVAL=15s
ALERTS_IN_UA_BASE_URL=https://api.alerts.in.ua/v1
ALERTS_IN_UA_TOKEN=
ALERTS_DEBOUNCE_TTL=1h

# --- Observability & Actuator ---
# Controls property sanitization masking in /actuator/env (NEVER, WHEN_AUTHORIZED, ALWAYS)
# Keep NEVER for production/shared environments; use ALWAYS for local development
ACTUATOR_SHOW_VALUES=NEVER
